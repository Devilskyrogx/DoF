<!-- Dialog Template — стиль главного меню игры (GameMenuFrame):
     NineSlice-рамка DialogBorderTemplate (мраморный фон UI-DialogBox-Background)
     + выступающий сверху DialogHeaderTemplate (diamond-metal шапка).
     Заголовок: self.Header:Setup("Название"). Крестик: self.CloseButton. -->
<Frame name="DoF_DialogTemplate" virtual="true"
       movable="true" enableMouse="true" frameStrata="FULLSCREEN_DIALOG"
       toplevel="true" hidden="true">
    <Frames>
        <Frame parentKey="Border" inherits="DialogBorderTemplate"/>
        <Frame parentKey="Header" inherits="DialogHeaderTemplate"/>
        <Button parentKey="CloseButton" inherits="UIPanelCloseButtonNoScripts">
            <Size x="24" y="24"/>
            <Anchors><Anchor point="TOPRIGHT" x="-4" y="-4"/></Anchors>
            <Scripts><OnClick>self:GetParent():Hide()</OnClick></Scripts>
        </Button>
    </Frames>
    <Scripts>
        <OnLoad>
            self:RegisterForDrag("LeftButton")
        </OnLoad>
        <OnDragStart>self:StartMoving()</OnDragStart>
        <OnDragStop>self:StopMovingOrSizing()</OnDragStop>
    </Scripts>
</Frame>


<!-- ═══════════════════════════════════════════════════════════════════════════
     GM PANEL
     ═══════════════════════════════════════════════════════════════════════════ -->
<Frame name="DoF_GMPanel" parent="UIParent" inherits="ButtonFrameTemplate" movable="true" enableMouse="true" frameStrata="DIALOG" toplevel="true" hidden="true">
<Size x="280" y="400"/>
<Anchors><Anchor point="CENTER" relativeTo="UIParent" relativePoint="CENTER" x="0" y="0"/></Anchors>
<Scripts>
    <OnLoad>
        ButtonFrameTemplate_HidePortrait(self)
        if self.TitleText then self.TitleText:SetText(DoF_L_GM_PANEL_TITLE) end
        self:RegisterForDrag("LeftButton")
        -- Иконка молотка слева от заголовка
        local icon = self:CreateTexture(nil, "OVERLAY")
        icon:SetTexture("Interface\\ICONS\\INV_Hammer_20")
        icon:SetSize(18, 18)
        if self.TitleText then
            icon:SetPoint("RIGHT", self.TitleText, "LEFT", -4, 0)
        else
            icon:SetPoint("TOPLEFT", self, "TOPLEFT", 60, -4)
        end
        self.TitleIcon = icon

        -- Классовый фон Inset: тот же атлас что в боковой панели аддона
        -- (UI-Character-Info-&lt;CLASS&gt;-BG, резолвится в PaperDollInfoPart1/2).
        if self.Inset then
            local bg = self.Inset:CreateTexture(nil, "BACKGROUND", nil, 2)
            bg:SetAllPoints(self.Inset)
            bg:SetAlpha(0.45)
            local _, class = UnitClass("player")
            local applied = false
            if class then
                local ok = pcall(bg.SetAtlas, bg, "UI-Character-Info-" .. class .. "-BG", true)
                if ok and bg:GetAtlas() then applied = true end
            end
            if not applied then
                bg:SetTexture(nil)
            end
            self.InsetBg = bg
        end

        -- Общий ScrollFrame внутри Inset. Симметричные отступы 22/22 —
        -- ScrollBar UIPanelScrollBarTemplate якорится на +6 вправо от scroll:TOPRIGHT
        -- и имеет ширину ~16, итого 22 — идеально вписывается в правый отступ.
        local scroll = CreateFrame("ScrollFrame", "DoF_GMPanel_Scroll", self, "UIPanelScrollFrameTemplate")
        scroll:SetPoint("TOPLEFT", self.Inset, "TOPLEFT", 22, -4)
        scroll:SetPoint("BOTTOMRIGHT", self.Inset, "BOTTOMRIGHT", -22, 4)

        local scrollChild = CreateFrame("Frame", "DoF_GMPanel_ScrollChild", scroll)
        scrollChild:SetSize(1, 1)
        scroll:SetScrollChild(scrollChild)

        self.Scroll = scroll
        self.ScrollChild = scrollChild
    </OnLoad>
    <OnDragStart>self:StartMoving()</OnDragStart>
    <OnDragStop>self:StopMovingOrSizing()</OnDragStop>
</Scripts>

